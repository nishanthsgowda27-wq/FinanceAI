# MySQL database used by the server APIs.
DB_HOST="127.0.0.1"
DB_PORT="3307"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="financeai"

# Gmail SMTP credentials used to send account verification codes.
# Create an App Password in your Google Account security settings; do not use
# your regular Gmail password.
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-character-google-app-password"

# Server-only Google Gemini key. Never use NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional: CIBIL threshold used by the server for automatic loan eligibility.
LOAN_MINIMUM_CIBIL_SCORE="750"


